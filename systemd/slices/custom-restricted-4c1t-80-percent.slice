[Slice]
# 80% of 4 logical CPUs = 320%
# CPU * percent: 4 (nproc) * 80
CPUQuota=320%
# Relative CPU scheduling weight, default 100
CPUWeight=80

MemoryMax=80%
MemorySwapMax=infinity
# Optional soft limit - reclaim starts above it, before the hard cap bites:
MemoryHigh=70%

# between 1 and 10000, default is 100
IOWeight=80
